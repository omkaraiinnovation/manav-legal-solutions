# ── AI Layer (pluggable, dual-provider) ─────────────────────────────────
# Set EITHER (or both — Anthropic is preferred when both are present) to
# enable live LLM calls, embeddings, and RAG-grounded Q&A. Provider is
# auto-detected from which key is present — see lib/agents/model-client.ts.
# With NEITHER key set, agents run in deterministic mock mode grounded only
# in the seeded knowledge base, and document Q&A explicitly reports
# "insufficient information" rather than fabricating an answer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model overrides (defaults shown)
MLS_MODEL_PRIMARY=claude-sonnet-5
MLS_MODEL_VERIFIER=claude-haiku-4-5-20251001
MLS_OPENAI_MODEL_PRIMARY=gpt-5
MLS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Data Layer (Supabase — Postgres + pgvector + Storage + Auth) ────────
# Required. There is no local/mock data mode anymore — auth, matters,
# documents, embeddings, and the knowledge base all live in Postgres with
# Row-Level Security enforcing tenant/matter isolation. Provision a project
# and run the migrations under supabase/migrations, then fill these in.
# The anon key is safe to expose to the browser (RLS does the enforcement);
# this app deliberately never uses a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
