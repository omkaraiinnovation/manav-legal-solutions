# ── AI Layer ─────────────────────────────────────────────────────────────
# Optional. When unset, all AI agents (Consultation, Drafting, Verification,
# Research) run in DETERMINISTIC MOCK MODE — grounded entirely in the seeded
# knowledge base under /data/seed, never fabricated. Adding a real key here
# switches every agent to live Claude calls with no code changes.
# See lib/agents/model-client.ts
ANTHROPIC_API_KEY=

# Model used for drafting/consultation (defaults shown)
MLS_MODEL_PRIMARY=claude-sonnet-5
MLS_MODEL_VERIFIER=claude-haiku-4-5-20251001

# ── Data Layer ───────────────────────────────────────────────────────────
# Local mode (default): JSON file store under /data/store, zero setup.
# Set to "supabase" once a Supabase project is provisioned (see
# supabase/migrations for the full schema this app expects).
MLS_DATA_MODE=local

# Only needed when MLS_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
